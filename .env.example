# All optional. App works with no keys (free public sources).
FRED_API_KEY=
NEWSAPI_KEY=
# Accounts (optional; without them the app runs in local mode with localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose with NEXT_PUBLIC. Needed for "Delete account".
SUPABASE_SERVICE_ROLE_KEY=
# Set to true after enabling the Google provider in Supabase
NEXT_PUBLIC_GOOGLE_AUTH=
